# STGR keeps the branding source outside the Firefox checkout. The build
# orchestrator stages this file and the assets into browser/branding/stgr.
#
# Firefox's branding contract (see browser/branding/nightly/moz.build) requires
# DIST_SUBDIR="browser" plus the FirefoxBranding() template from
# ../branding-common.mozbuild. The template installs the files that
# browser/installer/package-manifest.in expects at package time:
#   - bin/firefox.VisualElementsManifest.xml / private_browsing.VisualElementsManifest.xml
#     (FINAL_TARGET_FILES[".."] with DIST_SUBDIR -> bin/)
#   - bin/browser/VisualElements/*.png (FINAL_TARGET_FILES.VisualElements)
#   - bin/browser/defaults/preferences/firefox-branding.js (JS_PREFERENCE_FILES)
# Without these, `mach package` fails with "Missing file(s)".
# The locales subdir must be declared in DIRS (as upstream branding dirs do,
# e.g. browser/branding/nightly/moz.build) so the backend generates
# $(DEPTH)/browser/branding/stgr/locales/Makefile; the langpack build requires
# it (browser/locales/Makefile.in SUBMAKEFILES) or `mach package` dies with
# "No rule to make target '../../browser/branding/stgr/locales/Makefile'".
DIRS += ["locales"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

include("../branding-common.mozbuild")
FirefoxBranding()

FINAL_TARGET_FILES += [
    "brand.dtd",
    "brand.ftl",
    "brand.properties",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    FINAL_TARGET_FILES += [
        "default128.png",
        "default16.png",
        "default256.png",
        "default32.png",
        "default48.png",
        "default512.png",
        "default64.png",
        "document.ico",
        "document_pdf.ico",
        "firefox.ico",
        "newtab.ico",
        "newwindow.ico",
        "pbmode.ico",
    ]
