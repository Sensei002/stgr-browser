## STGR and Mozilla Brand
##
## STGR and Mozilla must be treated as a brand.
##
## They cannot be:
## - Transliterated.
## - Translated.
##
## Declension should be avoided where possible, leaving the original
## brand unaltered in prominent UI positions.
##
## For further details, consult:
## https://mozilla-l10n.github.io/styleguides/mozilla_general/#brands-copyright-and-trademark

-brand-shorter-name = STGR
-brand-short-name = STGR Browser
-brand-shortcut-name = STGR Browser
-brand-full-name = STGR Browser
# This brand name can be used in messages where the product name needs to
# remain unchanged across different versions.
-brand-product-name = STGR Browser
-vendor-short-name = STEiGER Dojo
trademarkInfo = { " " }

# Keys used by STGR's own brand.ftl (browser/branding/stgr/brand.ftl) so the
# langpack carries the same strings the main build reads at runtime.
-brand-name = STGR Browser
brand-short-name = STGR Browser
brand-full-name = STGR Browser
brand-short-name-with-vendor = STGR Browser
brand-footer = STEiGER Dojo
