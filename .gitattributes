# Normalise line endings so Windows-authored scripts stay usable on any runner
* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.nsi   text eol=crlf
*.nsh   text eol=crlf

# Binary assets must never be line-ending converted
*.png   binary
*.ico   binary
*.icns  binary
*.bmp   binary
*.zip   binary
*.exe   binary

# Diffs nobody reads
branding/icons/**        linguist-generated=true
overrides/windows/*.bmp  linguist-generated=true
ntp/config.js            linguist-generated=true
extensions/stgr-shield/rules/** linguist-generated=true
