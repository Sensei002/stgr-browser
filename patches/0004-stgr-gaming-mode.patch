diff --git a/browser/components/stgr/gamingmode/STGRGamingMode.sys.mjs b/browser/components/stgr/gamingmode/STGRGamingMode.sys.mjs
new file mode 100644
--- /dev/null
+++ b/browser/components/stgr/gamingmode/STGRGamingMode.sys.mjs
@@ -0,0 +1,103 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * STGR Gaming Mode — browser resource management while gaming.
+ *
+ * Scope: suspend background tabs where safe, reduce background timers,
+ * network, animations and preloading. NEVER touches other applications,
+ * game processes, GPU drivers, or OS security settings.
+ *
+ * Mode values (pref stgr.gamingMode.enabled): off | on | automatic.
+ * Automatic is a passive, non-invasive heuristic (see docs/gaming-mode.md).
+ */
+
+import { AppConstants } from "resource://gre/modules/AppConstants.sys.mjs";
+
+const PREF_ENABLED = "stgr.gamingMode.enabled";
+const PREF_AUTOMATIC = "stgr.gamingMode.automatic";
+const PREF_PROFILE = "stgr.memoryProfile";
+
+export var STGRGamingMode = {
+  _enabled: false,
+  _window: null,
+
+  init(window) {
+    this._window = window;
+    Services.prefs.addObserver(PREF_ENABLED, this);
+    Services.prefs.addObserver(PREF_AUTOMATIC, this);
+    Services.prefs.addObserver(PREF_PROFILE, this);
+    this._apply();
+  },
+
+  observe(subject, topic, data) {
+    if (topic === "nsPref:changed") {
+      this._apply();
+    }
+  },
+
+  _apply() {
+    const enabled = Services.prefs.getBoolPref(PREF_ENABLED, false);
+    const automatic = Services.prefs.getBoolPref(PREF_AUTOMATIC, false);
+    this._enabled = enabled || automatic;
+
+    // Dynamic resource adjustments. Static defaults live in the
+    // STGR PERFORMANCE PREFS block of browser/app/profile/firefox.js.
+    if (this._enabled) {
+      Services.prefs.setIntPref("browser.sessionstore.interval", 60000);
+      Services.prefs.setBoolPref("network.predictor.enabled", false);
+      Services.prefs.setBoolPref("network.preload", false);
+      Services.prefs.setIntPref("ui.prefersReducedMotion", 1);
+      Services.prefs.setBoolPref("browser.tabs.unloadOnLowMemory", true);
+      this._suspendBackgroundTabs();
+    } else {
+      Services.prefs.clearUserPref("browser.sessionstore.interval");
+      Services.prefs.clearUserPref("network.predictor.enabled");
+      Services.prefs.clearUserPref("network.preload");
+      Services.prefs.clearUserPref("ui.prefersReducedMotion");
+      Services.prefs.clearUserPref("browser.tabs.unloadOnLowMemory");
+    }
+  },
+
+  _suspendBackgroundTabs() {
+    if (!this._window?.gBrowser) {
+      return;
+    }
+    const protectAudio = Services.prefs.getBoolPref("stgr.gamingMode.protect.audio", true);
+    const protectVideo = Services.prefs.getBoolPref("stgr.gamingMode.protect.video", true);
+    const protectWebRTC = Services.prefs.getBoolPref("stgr.gamingMode.protect.webrtc", true);
+
+    for (const tab of this._window.gBrowser.tabs) {
+      if (tab === this._window.gBrowser.selectedTab) {
+        continue; // the active tab is never suspended
+      }
+      const browser = tab.linkedBrowser;
+      if (!browser || browser.isActive) {
+        continue;
+      }
+      if (protectAudio && browser.audioPlaybackStarted) {
+        continue;
+      }
+      if (protectVideo && browser.imageDocument?.mediaElement && !browser.paused) {
+        continue;
+      }
+      if (protectWebRTC && browser.hasActivePeerConnections) {
+        continue;
+      }
+      if (browser.discard) {
+        try {
+          browser.discard();
+        } catch (ex) {
+          // Tab not discardable (e.g. about: pages) — skip.
+        }
+      }
+    }
+  },
+
+  shutdown() {
+    Services.prefs.removeObserver(PREF_ENABLED, this);
+    Services.prefs.removeObserver(PREF_AUTOMATIC, this);
+    Services.prefs.removeObserver(PREF_PROFILE, this);
+  },
+};
