STGR PATCH: 0003 — Lightweight STGR New Tab page
Purpose:                Ship the official STEiGER Dojo logo with the UI. Replace the
                        (remote-rendered) Activity Stream new tab with a
                        lightweight, offline, no-telemetry STGR page (clock, search,
                        custom shortcuts). The canonical copies live in stgr/ui/ and are
                        staged by build_stgr.py prepare with template substitution.
                        Modern Firefox removed the old newtab override; this patch adds
                        the hook in AboutNewTabRedirector.defaultURL honoring the
                        browser.newtabpage.activity-stream.overrideURL pref (set in 0002).
Files changed:          browser/components/moz.build
                        browser/components/stgr/moz.build            (new)
                        browser/components/stgr/res/stgr/newtab/newtab.html   (staged by build_stgr.py)
                        browser/components/stgr/res/stgr/branding/stgr-logo.svg (staged, official logo)
                        browser/components/stgr/res/stgr/newtab/newtab.css    (staged)
                        browser/components/stgr/res/stgr/newtab/newtab.js     (staged)
                        browser/components/stgr/res/stgr/about/aboutStgr.html (staged)
                        browser/components/newtab/AboutNewTabRedirector.sys.mjs
Security impact:        None. The override only changes which local resource about:newtab
                        resolves to; pages are static content with no privileged access.
Performance impact:     Positive: replaces the heavy remote-rendered new tab with a few KB
                        of static HTML/CSS/JS. No idle timers beyond a local clock.
Upstream compatibility: moz.build RESOURCE_FILES + DIST_SUBDIR are stable surfaces
                        (editor/composer ships res/* exactly this way). The defaultURL
                        getter shape is verified against the release branch; rebase risk
                        LOW. Verify the packaged URL (resource://gre/res/stgr/) with the
                        smoke test and the package-time omni.ja check.

diff --git a/browser/components/moz.build b/browser/components/moz.build
--- a/browser/components/moz.build
+++ b/browser/components/moz.build
@@ -69,3 +69,4 @@
     "shell",
     "sidebar",
+    "stgr",
     "syncedtabs",
diff --git a/browser/components/stgr/moz.build b/browser/components/stgr/moz.build
new file mode 100644
--- /dev/null
+++ b/browser/components/stgr/moz.build
@@ -0,0 +1,37 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+# browser/moz.build exports DIST_SUBDIR="browser" to this subtree. Reset it
+# so these files install to Firefox's global resource namespace (the GRE
+# root) and the resource://gre URLs configured by STGR resolve in packaged
+# builds. RESOURCE_FILES cannot be combined with a truthy DIST_SUBDIR.
+DIST_SUBDIR = ""
+
+# 0004 and 0006 add runtime ESM modules below this directory. DIRS is
+# required so mozbuild descends into those directories and installs the
+# modules referenced by browser-init.js and the updater.
+DIRS += [
+    "gamingmode",
+    "updater",
+]
+
+# RESOURCE_FILES maps to FINAL_TARGET_FILES.res: entries install under
+# dist/bin/res/ and the destination subpath comes from the hierarchical
+# field access (RESOURCE_FILES.<dir> += ...), NOT from the entry string
+# (only the basename of each entry is used). With DIST_SUBDIR="" that is
+# the GRE root, so the entries below land at dist/bin/res/stgr/... -> root
+# omni.ja -> resource://gre/res/stgr/... (the same mechanism editor/composer
+# uses for its res/* files - no jar.mn involved).
+RESOURCE_FILES.stgr.about += [
+    "res/stgr/about/aboutStgr.html",
+]
+RESOURCE_FILES.stgr.branding += [
+    "res/stgr/branding/stgr-logo.svg",
+]
+RESOURCE_FILES.stgr.newtab += [
+    "res/stgr/newtab/newtab.css",
+    "res/stgr/newtab/newtab.html",
+    "res/stgr/newtab/newtab.js",
+]
+with Files("**"):
+    BUG_COMPONENT = ("STGR Browser", "UI")

diff --git a/browser/components/newtab/AboutNewTabRedirector.sys.mjs b/browser/components/newtab/AboutNewTabRedirector.sys.mjs
--- a/browser/components/newtab/AboutNewTabRedirector.sys.mjs
+++ b/browser/components/newtab/AboutNewTabRedirector.sys.mjs
@@ -427,4 +427,12 @@
   get defaultURL() {
+    // STGR: allow replacing the new tab with a fully local page.
+    const overrideURL = Services.prefs.getStringPref(
+      "browser.newtabpage.activity-stream.overrideURL",
+      ""
+    );
+    if (overrideURL) {
+      return overrideURL;
+    }
     if (this.remoteRendererEnabled) {
       return "resource://newtab/data/content/remote-renderer-host.html";
     }
